# Copy this file to .env and fill in your values
# Never commit .env to git

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_API_KEY=your-api-key-here

# Azure OpenAI Embeddings
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# PostgreSQL — admin user (used by ingest, schema migrations, generate_data.py)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=enterprise_support_db
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password

# PostgreSQL — read-only user (used by Agent 3 SQL queries — SELECT only, SLO #12)
# Setup in psql:
#   CREATE USER support_reader WITH PASSWORD 'your_reader_password';
#   GRANT SELECT ON ALL TABLES IN SCHEMA public TO support_reader;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT ON TABLES TO support_reader;
POSTGRES_READER_USER=support_reader
POSTGRES_READER_PASSWORD=your_reader_password

# LlamaParse
LLAMA_CLOUD_API_KEY=your-llama-cloud-api-key

# Langfuse
LANGFUSE_PUBLIC_KEY=your-public-key
LANGFUSE_SECRET_KEY=your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# Jira Service Management — escalation handoff (Agent 5)
JIRA_BASE_URL=https://yoursite.atlassian.net
JIRA_EMAIL=your-atlassian-email
JIRA_API_TOKEN=your-api-token
JIRA_PROJECT_KEY=SUP
