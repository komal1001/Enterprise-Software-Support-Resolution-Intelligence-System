# Copy this file to .env and fill in your values
# Never commit .env to git

# LLM provider — any OpenAI-compatible API (see src/llm.py)
# OpenAI key from platform.openai.com/api-keys (prepaid credit, keep auto-recharge off)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-openai-key
# Optional overrides (defaults shown). Embedding model must stay text-embedding-3-small
# unless you re-run ingest — stored pgvector embeddings were made with it.
# LLM_CHAT_MODEL=gpt-4o-mini
# LLM_EMBED_MODEL=text-embedding-3-small

# PostgreSQL — admin user (used by ingest, schema migrations, generate_data.py)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=enterprise_support_db
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password

# PostgreSQL — read-only user. REQUIRED: the SQL agent (src/rag/sql.py) runs
# LLM-generated SQL and logs in only as this role (least privilege, SLO #12).
# It refuses to start without it rather than fall back to the owner account.
# Setup in psql:
#   CREATE USER support_reader WITH PASSWORD 'your_reader_password';
#   GRANT SELECT ON ALL TABLES IN SCHEMA public TO support_reader;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT ON TABLES TO support_reader;
POSTGRES_READER_USER=support_reader
POSTGRES_READER_PASSWORD=your_reader_password

# LlamaParse
LLAMA_CLOUD_API_KEY=your-llama-cloud-api-key

# Langfuse
LANGFUSE_PUBLIC_KEY=your-public-key
LANGFUSE_SECRET_KEY=your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# Jira Service Management — escalation handoff (Agent 5)
JIRA_BASE_URL=https://yoursite.atlassian.net
JIRA_EMAIL=your-atlassian-email
JIRA_API_TOKEN=your-api-token
JIRA_PROJECT_KEY=SUP
