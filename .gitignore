# Environment variables — never commit credentials
.env

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*.egg-info/
dist/
build/
.venv/
env/
.coverage

# LlamaIndex cache — nodes_cache.json must be committed (BM25 corpus needed at runtime)

# DB dumps (keep schema.sql — exclude only binary dumps)
*.dump
*.backup

# OS
.DS_Store
Thumbs.db

# MS Office temp lock files
"diagrams and tracker/~$*"

# Runtime outputs — generated by eval pipeline, not source
eval/eval_results.json
eval_output.txt

# Frontend build output — Vercel builds from source, no need to commit dist
frontend-react/dist/
